<configuration>
    <appender name="File" class="ch.qos.logback.core.FileAppender">
        <file>logs/app.log</file>
        <appender>false</appender>
        <encoder>
            <pattern>%d{HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="File"/>
    </root>
</configuration>